{% extends 'base.html.twig' %}

{% block title %}
    Véhicloc - Accueil
{% endblock %}

{% block header_content %}
    <div class="flex-header">
        <div>
            <h1>Louez une voiture simplement</h1>

            <p>
                Découvrez notre sélection de véhicules disponibles
                à la location.
            </p>
        </div>

        <div>
            <img
                src="{{ asset('img/bg-car.png') }}"
                alt="Voiture de location"
            >
        </div>
    </div>
{% endblock %}

{% block body %}
    <section id="fleet">
        <h2>Notre flotte de véhicules</h2>

        <p>
            Choisissez la voiture adaptée à vos déplacements.
        </p>

        <div class="fleet-list">
            {% for voiture in voitures %}
                <article>
                    <div class="mini-car-title">
                        <a
                            href="{{ path(
                                'app_voiture_detail',
                                {id: voiture.id}
                            ) }}"
                        >
                            <h3>{{ voiture.name }}</h3>
                            <p>ou similaire | Saint-Étienne</p>
                        </a>

                        <div class="car-actions">

                            <a
                                href="{{ path(
                                    'app_voiture_supprimer',
                                    {id: voiture.id}
                                ) }}"
                                class="delete-button"
                                onclick="return confirm(
                                    'Voulez-vous vraiment supprimer cette voiture ?'
                                );"
                                aria-label="Supprimer {{ voiture.name }}"
                            >
                                <img
                                    src="{{ asset('icons/trash.png') }}"
                                    alt="Supprimer"
                                >
                            </a>
                        </div>
                    </div>

                    <a
                        href="{{ path(
                            'app_voiture_detail',
                            {id: voiture.id}
                        ) }}"
                        class="mini-car-photo"
                    >
                        <img
                            src="{{ asset('img/car.png') }}"
                            alt="{{ voiture.name }}"
                            class="mini-car-image"
                        >
                    </a>

                    <div class="mini-car-icons">
                        <div>
                            <img
                                src="{{ asset('icons/persons.png') }}"
                                alt=""
                            >

                            <p>{{ voiture.places }} places</p>
                        </div>

                        <div>
                            <img
                                src="{{ asset('icons/motor.png') }}"
                                alt=""
                            >

                            <p>
                                {% if voiture.manual %}
                                    Manuelle
                                {% else %}
                                    Automatique
                                {% endif %}
                            </p>
                        </div>

                        <div>
                            <img
                                src="{{ asset('icons/km.png') }}"
                                alt=""
                            >

                            <p>Km illimités</p>
                        </div>

                        <div>
                            <img
                                src="{{ asset('icons/plus.png') }}"
                                alt=""
                            >

                            <p>Plus</p>
                        </div>
                    </div>

                    <div class="mini-car-price">
                        <p class="price-per-day">
                            {{ voiture.dailyPrice
                                |number_format(2, ',', ' ') }}
                            € / jour
                        </p>

                        <p class="price-per-month">
                            {{ voiture.monthlyPrice
                                |number_format(2, ',', ' ') }}
                            € / mois
                        </p>
                    </div>
                </article>
            {% else %}
                <p>Aucune voiture disponible actuellement.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}