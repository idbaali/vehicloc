{% extends 'base.html.twig' %}

{% block title %}
    Accueil - Véhicloc
{% endblock %}

{% block body %}

<header>
    <nav>
        <a href="{{ path('app_accueil') }}">
            <img src="{{ asset('img/logo.png') }}" alt="Véhicloc">
        </a>

        <a href="{{ path('app_voiture_ajouter') }}" class="btn-nav">
            Ajouter une voiture
        </a>
    </nav>

    <div class="flex-header">
        <div>
            <h1>Location de voitures à Saint-Étienne</h1>
            <p>
                Un service de location de voitures au mois
                pour répondre à vos besoins de mobilité.
            </p>
        </div>

        <div>
            <img src="{{ asset('img/car.png') }}" alt="Voiture">
        </div>
    </div>
</header>

<section id="fleet">
    <h2>Découvrez la flotte de véhicules chez Véhicloc</h2>

    <p>
        Que vous ayez besoin d'une petite citadine agile,
        d'une berline élégante ou d'un SUV spacieux,
        nous avons une variété de véhicules pour répondre à vos exigences.
    </p>

    <div class="fleet-list">
        {% for voiture in voitures %}
            <article>
                <div class="mini-car-title">
                    <a href="{{ path('app_voiture_detail', {
                        id: voiture.id
                    }) }}">
                        <h3>{{ voiture.name }}</h3>
                        <p>ou similaire | Saint-Étienne</p>
                    </a>

                    <div>
                        <form
                            method="post"
                            action="{{ path('app_voiture_supprimer', {
                                id: voiture.id
                            }) }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete' ~ voiture.id) }}"
                            >

                            <button type="submit" class="delete-button">
                                <img
                                    src="{{ asset('icons/trash.png') }}"
                                    alt="Supprimer"
                                >
                            </button>
                        </form>
                    </div>
                </div>

                <div class="mini-car-icons">
                    <div>
                        <img
                            src="{{ asset('icons/persons.png') }}"
                            alt="{{ voiture.places }} places"
                        >
                        <p>{{ voiture.places }} places</p>
                    </div>

                    <div>
                        <img
                            src="{{ asset('icons/motor.png') }}"
                            alt="{{ voiture.motor }}"
                        >
                        <p>{{ voiture.motor }}</p>
                    </div>

                    <div>
                        <img
                            src="{{ asset('icons/km.png') }}"
                            alt="Km illimités"
                        >
                        <p>Km illimités</p>
                    </div>

                    <div>
                        <img
                            src="{{ asset('icons/plus.png') }}"
                            alt="Plus"
                        >
                        <p>Plus</p>
                    </div>
                </div>

                <div class="mini-car-price">
                    <p class="price-per-day">
                        {{ voiture.dailyPrice|number_format(2, ',', ' ') }}
                        € / jour
                    </p>

                    <p class="price-per-month">
                        {{ voiture.monthlyPrice|number_format(2, ',', ' ') }}
                        € / mois
                    </p>
                </div>
            </article>
        {% else %}
            <p>Aucune voiture disponible actuellement.</p>
        {% endfor %}
    </div>
</section>

<section id="promises">
    <div>
        <h2>La promesse Véhicloc</h2>

        <div class="promise">
            <img
                src="{{ asset('icons/insurance.png') }}"
                alt="Assurance et Assistance"
            >

            <div class="promise-text">
                <h3>Assurance et Assistance</h3>
                <p>
                    Votre tranquillité d'esprit est notre priorité.
                    Toutes nos locations mensuelles incluent une assurance complète
                    et une assistance routière.
                </p>
            </div>
        </div>

        <div class="promise">
            <img
                src="{{ asset('icons/booking.png') }}"
                alt="Réservation facile"
            >

            <div class="promise-text">
                <h3>Réservation facile</h3>
                <p>
                    Notre plateforme vous permet de réserver votre voiture
                    en quelques clics.
                </p>
            </div>
        </div>
    </div>

    <div>
        <img
            src="{{ asset('img/promise.png') }}"
            alt="La promesse Véhicloc"
        >
    </div>
</section>

<footer>
    <h2>Conduire avec nous</h2>

    <nav>
        <ul>
            <li><a href="#">Mentions légales</a></li>
            <li><a href="#">Nous contacter</a></li>
            <li>
                <a href="#">
                    <img
                        src="{{ asset('icons/instagram.png') }}"
                        alt="Instagram"
                    >
                </a>

                <a href="#">
                    <img
                        src="{{ asset('icons/facebook.png') }}"
                        alt="Facebook"
                    >
                </a>
            </li>
        </ul>

        <ul>
            <li><a href="#">Données personnelles</a></li>
            <li><a href="#">Questions fréquentes</a></li>
            <li class="copyright">© Véhicloc 2026</li>
        </ul>
    </nav>
</footer>

{% endblock %}