{% extends 'base.html.twig' %}

{% block title %}
    Ajouter une voiture
{% endblock %}

{% block body %}
    <section id="add">
        <a href="{{ path('app_accueil') }}">
            ← Retour à l’accueil
        </a>

        <h1>Ajouter une voiture</h1>

        {{ form_start(form) }}

            <div class="input">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="input">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="flex-input">
                <div class="input">
                    {{ form_label(form.dailyPrice) }}
                    {{ form_widget(form.dailyPrice) }}
                    {{ form_errors(form.dailyPrice) }}
                </div>

                <div class="input">
                    {{ form_label(form.monthlyPrice) }}
                    {{ form_widget(form.monthlyPrice) }}
                    {{ form_errors(form.monthlyPrice) }}
                </div>
            </div>

            <div class="input">
                {{ form_label(form.places) }}
                {{ form_widget(form.places) }}
                {{ form_errors(form.places) }}
            </div>

            <div class="checkbox-input">
                {{ form_widget(form.manual) }}
                {{ form_label(form.manual) }}
                {{ form_errors(form.manual) }}
            </div>

            {{ form_widget(form.submit) }}

        {{ form_end(form) }}
    </section>
{% endblock %}