<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>{% block title %}Véhicloc{% endblock %}</title>

    {% block stylesheets %}
        <link
            rel="stylesheet"
            href="{{ asset('css/style.css') }}"
        >
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body>

<header>
    <nav>
        <a href="{{ path('app_accueil') }}">
            <img
                src="{{ asset('img/logo.png') }}"
                alt="Logo Véhicloc"
            >
        </a>

        <a
            href="{{ path('app_voiture_ajouter') }}"
            class="btn-nav"
        >
            Ajouter une voiture
        </a>
    </nav>

    {% block header_content %}{% endblock %}
</header>

{% for message in app.flashes('success') %}
    <div class="flash-success">
        {{ message }}
    </div>
{% endfor %}

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    <h2>Véhicloc</h2>

    <nav>
        <ul>
            <li>
                <a href="{{ path('app_accueil') }}">
                    Accueil
                </a>
            </li>

            <li>
                <a href="{{ path('app_voiture_ajouter') }}">
                    Ajouter une voiture
                </a>
            </li>

            <li class="copyright">
                © {{ 'now'|date('Y') }} Véhicloc
            </li>
        </ul>
    </nav>
</footer>

</body>
</html>